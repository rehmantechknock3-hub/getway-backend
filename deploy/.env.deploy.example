# Copy this file to deploy/.env.deploy and fill in real values yourself.
# deploy/.env.deploy is gitignored and is only ever read locally by the deploy/*.sh
# scripts — its values are never printed to the terminal or sent anywhere except
# straight into AWS Secrets Manager / the App Runner service config.

# From the Clerk dashboard (same values already in your Render service env vars)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# From the Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Cloud Console → the key already used for Maps/Places/Distance Matrix
GOOGLE_MAPS_API_KEY=

# Render dashboard → your Postgres database → "External Connection String"
# (only needed for deploy/10-migrate-data.sh; safe to leave blank until then)
RENDER_DATABASE_URL=

# ── Mobile / TestFlight ─────────────────────────────────────────────────────
# Stripe dashboard → Publishable key (starts pk_test_ or pk_live_ — NOT the secret key above)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Google Cloud Console — the client-side Maps key (may be the same value as GOOGLE_MAPS_API_KEY
# above, or a separate key restricted to iOS/Android — use whichever one the mobile app expects)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# App Store Connect → Users and Access → Integrations → Keys → generate a new key.
# Save the downloaded .p8 file as deploy/AuthKey.p8 (gitignored, *.p8 is already covered).
# Then fill in the Key ID and Issuer ID shown on that same page:
ASC_API_KEY_ID=
ASC_API_KEY_ISSUER_ID=
