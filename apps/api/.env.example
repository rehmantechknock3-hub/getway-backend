# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Optional bind host. Leave unset for Node default (recommended for iOS Simulator + localhost/IPv6).
# Set HOST=0.0.0.0 only if you need IPv4-only LAN access and understand IPv6 localhost may not connect.
# HOST=
WEB_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# ── Expo / mobile (read by @repo/mobile `dev` script via `set -a; . ../api/.env`) ──
# LOCAL DEV ONLY — point these at your machine. Do NOT use the Render URL while developing
# in the simulator. Use Render (https://getway-api.onrender.com) only for production builds.
# iOS Simulator: http://127.0.0.1:3010 (or localhost). Match PORT below.
# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.42:3010 (phone + PC on same Wi‑Fi).
# Android emulator: http://10.0.2.2:3010
# After changing this, restart Expo with a clean cache: `expo start -c`. For dev builds, `usesCleartextTraffic` in app.json allows http:// to that host (re-run `expo run:android` / `expo run:ios` if needed).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
# iOS Simulator: if requests show "Network Error", use http://127.0.0.1:3010 (the app also rewrites localhost→127.0.0.1 on iOS).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3010
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3010
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Optional — server-side geocode / places (admin booking map search + reverse geocode) and
# provider discovery distances. Enable Places API + Geocoding API (+ Distance Matrix) on this key:
GOOGLE_MAPS_API_KEY=
# Hours to reuse cached Distance Matrix results per (rounded origin, provider, rounded destination). Default 24.
DRIVING_DISTANCE_CACHE_TTL_HOURS=24

# ── Database (Docker local) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/marketplace"

# ── Clerk ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_COMMISSION_PERCENT=15

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=marketplace-assets
